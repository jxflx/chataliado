# ==============================================================================
# ChatAliado — Workspace Environment Configuration Example
# ==============================================================================
# Este archivo sirve como referencia centralizada para la arquitectura de ChatAliado.
# Cada subsistema tiene su propio archivo de variables de entorno para desarrollo local:
#
# 1. Cloudflare Worker (Backend & Orquestador de IA):
#    Copiar `worker/.dev.vars.example` a `worker/.dev.vars`
#
# 2. Next.js Dashboard (KDS, Chats en Vivo, Menú y Administración):
#    Copiar `dashboard/.env.example` a `dashboard/.env.local`
#
# 3. Docker Compose (Evolution API & PostgreSQL local opcional):
#    Las variables de conexión por defecto se definen en `docker-compose.yml`.
# ==============================================================================

# Variables globales para Docker Compose (opcional)
EVOLUTION_API_KEY=test-evo-api-key
WEBHOOK_VERIFY_TOKEN=test-webhook-verify-token-123
PHONE_WHITELIST=
MAX_MESSAGE_AGE_SECONDS=120
