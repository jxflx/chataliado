# Base de datos: SQLite por defecto en desarrollo.
# Para PostgreSQL usa por ejemplo:
# DATABASE_URL=postgresql+psycopg://chataliado:chataliado@localhost:5432/chataliado
DATABASE_URL=sqlite:///./chataliado.db

# Secreto para firmar JWT (obligatorio cambiarlo en producción)
SECRET_KEY=cambia-este-secreto-en-produccion

# Minutos de vida del token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes permitidos para CORS (separados por coma). El dashboard se sirve
# desde el propio backend, así que en local no se necesita nada extra.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
