# ==============================================================================
# ChatAliado — Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables & secrets (STRICT: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*token*.txt
*.crt

# Cloudflare Wrangler & Workers
.wrangler/
**/.wrangler/

# Next.js & Turbopack
.next/
**/.next/
out/
**/out/
.turbo/
**/.turbo/

# Build artifacts & TypeScript
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Logs & Debugging
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python & Virtual Environments (Legacy)
.venv/
__pycache__/
*.pyc
*.db
.pytest_cache/
.ruff_cache/
*.egg-info/

# Scratch & Archives
_archive/
scratch/

# Operating System & IDE
.DS_Store
Thumbs.db
.obsidian/
**/.obsidian/

# Internal Agent Traces & Knowledge Graph
graphify-out/
.agents/*
!.agents/rules/
!.agents/rules/**
